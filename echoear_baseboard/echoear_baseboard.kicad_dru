(version 1)

(rule "Allow Via In Pad Spacing"
    (constraint clearance (min 0mm))
    (constraint hole_clearance (min 0mm))
    (condition "A.Type == 'via' && B.Type == 'pad' && A.Net == B.Net"))

(rule "JLCPCB Via In Pad Dimensions"
    (constraint hole_size (min 0.25mm) (max 0.35mm))
    (constraint via_diameter (max 0.55mm))
    (condition "A.NetClass == 'ViaInPad'"))
